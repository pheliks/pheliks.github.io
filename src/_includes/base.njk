<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} | {{ site.title }}</title>
  <meta name="description" content="{{ description or title }}">
  <link rel="canonical" href="{{ page.url | absoluteUrl }}">
  <meta property="og:title" content="{{ title }}">
  <meta property="og:description" content="{{ description or title }}">
  <meta property="og:url" content="{{ page.url | absoluteUrl }}">
  <meta property="og:type" content="{{ 'article' if author else 'website' }}">
  <link rel="icon" href="/favicon.ico">
  <link rel="alternate" type="application/atom+xml" href="/feed.xml" title="{{ site.title }}">
  <link rel="stylesheet" href="/assets/site.css">
</head>
<body class="{% if hero %}page-event{% elif author %}page-article{% elif page.url == '/' %}page-home{% else %}page-standard{% endif %}">
  <a class="skip-link" href="#main">Skip to content</a>
  <header class="site-header{% if not hero %} academic-header{% endif %}">
    {% if hero %}<a class="site-name" href="/">{{ site.title }}</a>{% endif %}
    <nav aria-label="Main navigation">
      {% for item in site.data.navigation.main %}<a href="{{ item.url }}"{% if page.url == item.url %} aria-current="page"{% endif %}>{{ item.title }}</a>{% endfor %}
    </nav>
  </header>
  <div class="layout{% if hero %} full-width{% endif %}">
    {% if not hero %}<aside class="profile" aria-label="Profile">
      <img src="{{ '/assets/logoSmall.png' if author else '/assets/portfolio.png' }}" alt="Viktor Zamaraev" width="180" height="180">
      <div class="profile-details">
      <h2>{{ site.title }}</h2>
      <p>Associate Professor (Reader)<br>School of Computer Science &amp; Informatics<br>University of Liverpool</p>
      <nav class="profile-links" aria-label="Academic profiles and contact">
        <a href="https://scholar.google.com/citations?user=HpS4Y2wAAAAJ" aria-label="Google Scholar" title="Google Scholar" target="_blank" rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M5.242 13.769L0 9.5 12 0l12 9.5-5.242 4.269C17.548 11.249 14.978 9.5 12 9.5c-2.977 0-5.548 1.748-6.758 4.269zM12 10a7 7 0 1 0 0 14 7 7 0 0 0 0-14z"/></svg>
        </a>
        <a href="https://dblp.org/pid/57/10717.html" aria-label="DBLP" title="DBLP" target="_blank" rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><path d="M3.075.002c-.096.013-.154.092-.094.31L4.97 7.73 3.1 8.6s-.56.26-.4.85l2.45 9.159s.16.59.72.33l6.169-2.869 1.3-.61s.52-.24.42-.79l-.01-.06-1.13-4.22-.658-2.45-.672-2.49v-.04s-.16-.59-.84-1L3.5.141s-.265-.16-.425-.139zM18.324 5.03a.724.724 0 0 0-.193.06l-5.602 2.6.862 3.2 1.09 4.08.01.06c.05.47-.411.79-.411.79l-1.88.87.5 1.89.04.1c.07.17.28.6.81.91l6.95 4.269s.68.41.52-.17l-1.981-7.4 1.861-.86s.56-.26.4-.85L18.85 5.42s-.116-.452-.526-.39z"/></svg>
        </a>
        <a href="https://www.linkedin.com/in/victor-zamaraev-1bb46317/" aria-label="LinkedIn" title="LinkedIn" target="_blank" rel="noopener noreferrer">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 448 512" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false"><!--! Font Awesome Free 6.7.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free (Icons: CC BY 4.0) Copyright 2024 Fonticons, Inc. --><path d="M100.28 448H7.4V148.9h92.88zM53.79 108.1C24.09 108.1 0 83.5 0 53.8a53.79 53.79 0 0 1 107.58 0c0 29.7-24.1 54.3-53.79 54.3zM447.9 448h-92.68V302.4c0-34.7-.7-79.2-48.29-79.2-48.29 0-55.69 37.7-55.69 76.7V448h-92.78V148.9h89.08v40.8h1.3c12.4-23.5 42.69-48.3 87.88-48.3 94 0 111.28 61.9 111.28 142.3V448z"/></svg>
        </a>
        <a href="mailto:Viktor.Zamaraev@liverpool.ac.uk" aria-label="Email" title="Email Viktor Zamaraev">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
        </a>
      </nav>
      </div>
    </aside>{% endif %}
    <main id="main" tabindex="-1">
      {% if hero %}<header class="hero{% if hero_credit %} hero--credited{% endif %}" style="background-image:linear-gradient(90deg,rgba(12,30,35,.86),rgba(12,30,35,.45)),url('{{ hero }}'){% if hero_position %};background-position:{{ hero_position }}{% endif %}"><h1 id="page-title">{{ title }}</h1>{% if lead %}<p>{{ lead }}</p>{% endif %}</header>{% if hero_credit %}<p class="hero-credit">Photo: <a href="{{ hero_credit.author_url }}">{{ hero_credit.author }}</a> · <a href="{{ hero_credit.license_url }}">{{ hero_credit.license }}</a> · <a href="{{ hero_credit.source_url }}">Source</a></p>{% endif %}{% else %}<header class="page-heading"><h1 id="page-title">{{ title }}</h1></header>{% endif %}
      <article class="page__content">{{ content | safe }}</article>
    </main>
  </div>
</body>
</html>
